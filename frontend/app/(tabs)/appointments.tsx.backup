/**
 * Appointments Screen - Calendar-first design
 * Shows calendar directly with upcoming appointments
 */
import React, { useState, useEffect, useCallback, useMemo, useRef } from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
  RefreshControl,
  Alert,
  Linking,
  Platform,
  Animated,
  ActivityIndicator,
  TextInput,
  Modal,
  KeyboardAvoidingView,
} from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
// expo-clipboard removed - not used and may cause TurboModule crash
import { useRouter } from 'expo-router';
import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { useTranslation } from 'react-i18next';
import { LightColors } from '../../constants/colors';
import api from '../../services/api';
import {
  format, addMonths, subMonths, startOfMonth, endOfMonth,
  eachDayOfInterval, startOfWeek, endOfWeek,
  isSameDay, isToday, isTomorrow, isSameMonth, isPast,
  differenceInDays, differenceInHours, differenceInMinutes,
} from 'date-fns';
import { es, enUS } from 'date-fns/locale';
import { useAuth } from '../../contexts/AuthContext';
import AsyncStorage from '@react-native-async-storage/async-storage';

interface Appointment {
  id: string;
  title: string;
  description: string;
  scheduled_at: string;
  duration_minutes: number;
  status: string;
  appointment_type: string;
  meeting_link: string;
  created_at: string;
  staff_name?: string;
  location?: string;
}

interface TimeSlot {
  time: string;
  datetime: string;
  available: boolean;
}

const DAY_NAMES_ES = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
const DAY_NAMES_EN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

export default function AppointmentsScreen() {
  const { t, i18n } = useTranslation();
  const dateLocale = i18n.language === 'en' ? enUS : es;
  const DAY_NAMES = i18n.language === 'en' ? DAY_NAMES_EN : DAY_NAMES_ES;
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const { user } = useAuth();
  // Use static colors instead of dynamic theme to avoid crash
  const colors = LightColors;
  const s = React.useMemo(() => createStyles(colors), []);

  // Appointments state
  const [appointments, setAppointments] = useState<Appointment[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  // Calendar/booking state
  const [currentMonth, setCurrentMonth] = useState(new Date());
  const [selectedDate, setSelectedDate] = useState<Date | null>(null);
  const [selectedTime, setSelectedTime] = useState<string | null>(null);
  const [timeSlots, setTimeSlots] = useState<TimeSlot[]>([]);
  const [loadingSlots, setLoadingSlots] = useState(false);
  const [appointmentType, setAppointmentType] = useState<'in_person' | 'video_call'>('in_person');
  const [booking, setBooking] = useState(false);
  const [services, setServices] = useState<any[]>([]);
  const [selectedService, setSelectedService] = useState<any>(null);
  const [officeStatus, setOfficeStatus] = useState<any>(null);
  const [showHistory, setShowHistory] = useState(false);

  // Multi-person booking state
  const [quantity, setQuantity] = useState(1);
  const [attendees, setAttendees] = useState<{ name: string; phone: string; relationship: string }[]>([]);
  const [showAttendeeForm, setShowAttendeeForm] = useState(false);

  // Payment method state (optional pre-registration)
  const [paymentMethods, setPaymentMethods] = useState<any[]>([]);
  const [selectedPaymentMethod, setSelectedPaymentMethod] = useState<string | null>(null);
  const [loadingPayments, setLoadingPayments] = useState(false);
  const [showPaymentSection, setShowPaymentSection] = useState(false);

  // Inline add card modal state
  const [showAddCardModal, setShowAddCardModal] = useState(false);
  const [savingCard, setSavingCard] = useState(false);
  const [newCardNumber, setNewCardNumber] = useState('');
  const [newCardExpMonth, setNewCardExpMonth] = useState('');
  const [newCardExpYear, setNewCardExpYear] = useState('');
  const [newCardCVV, setNewCardCVV] = useState('');
  const [newCardName, setNewCardName] = useState('');

  const CACHE_KEY = 'appointments_cache';

  useEffect(() => {
    if (user) {
      loadAppointments();
      loadOfficeStatus();
      loadServices();
      loadPaymentMethods();
    } else {
      setLoading(false);
    }
  }, [user]);

  const loadAppointments = async () => {
    try {
      const cached = await AsyncStorage.getItem(CACHE_KEY);
      if (cached && !refreshing) {
        const p = JSON.parse(cached);
        if (p.data && Date.now() - p.timestamp < 5 * 60 * 1000) {
          setAppointments(p.data);
          setLoading(false);
        }
      }
      const res = await api.get('/appointments/my');
      const sorted = (res.data || []).sort(
        (a: Appointment, b: Appointment) => new Date(b.scheduled_at).getTime() - new Date(a.scheduled_at).getTime()
      );
      setAppointments(sorted);
      await AsyncStorage.setItem(CACHE_KEY, JSON.stringify({ data: sorted, timestamp: Date.now() }));
    } catch (error: any) {
      console.error('Error loading appointments:', error);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  };

  const loadOfficeStatus = async () => {
    try {
      const res = await api.get('/office-hours/status');
      setOfficeStatus(res.data);
    } catch (e) { console.error(e); }
  };

  const loadServices = async () => {
    try {
      const res = await api.get(`/services/available?lang=${i18n.language}`);
      const list = res.data?.services || [];
      setServices(list);
      if (list.length > 0) { setSelectedService(list[0]); }
    } catch (e) {
      const fb = [{ id: 'default', name: t('appointments.personalReturn'), duration_minutes: 30 }];
      setServices(fb);
      setSelectedService(fb[0]);
    }
  };

  const loadPaymentMethods = async () => {
    try {
      setLoadingPayments(true);
      const res = await api.get('/payment-methods');
      const methods = res.data?.payment_methods || [];
      setPaymentMethods(methods);
    } catch (e) {
      console.error('Error loading payment methods:', e);
    } finally {
      setLoadingPayments(false);
    }
  };

  // Format card number with spaces for display
  const formatCardNumber = (text: string) => {
    const clean = text.replace(/\D/g, '').slice(0, 16);
    const groups = clean.match(/.{1,4}/g);
    return groups ? groups.join(' ') : clean;
  };

  // Save a new card inline during appointment booking
  const handleSaveCardInline = async () => {
    const cleanNumber = newCardNumber.replace(/\s/g, '').replace(/-/g, '');
    if (cleanNumber.length < 13 || cleanNumber.length > 19) {
      Alert.alert(t('common.error', 'Error'), t('appointments.invalidCardNumber', 'Número de tarjeta inválido'));
      return;
    }
    const expM = parseInt(newCardExpMonth);
    const expY = parseInt(newCardExpYear);
    if (!expM || expM < 1 || expM > 12) {
      Alert.alert(t('common.error', 'Error'), t('appointments.invalidExpMonth', 'Mes de expiración inválido'));
      return;
    }
    if (!expY || expY < 25 || expY > 40) {
      Alert.alert(t('common.error', 'Error'), t('appointments.invalidExpYear', 'Año de expiración inválido'));
      return;
    }
    if (newCardCVV.length < 3) {
      Alert.alert(t('common.error', 'Error'), t('appointments.invalidCVV', 'CVV inválido'));
      return;
    }

    try {
      setSavingCard(true);
      const response = await api.post('/payment-methods', {
        card_number: cleanNumber,
        exp_month: expM,
        exp_year: 2000 + expY,
        cvv: newCardCVV,
        cardholder_name: newCardName.trim() || undefined,
        is_default: paymentMethods.length === 0,
      });

      if (response.data.success) {
        Alert.alert(
          t('appointments.cardSaved', '✅ Tarjeta Guardada'),
          t('appointments.cardSavedMsg', 'Tu tarjeta fue registrada exitosamente y se usará para esta cita.')
        );
        await loadPaymentMethods();
        const newMethod = response.data.payment_method;
        if (newMethod?.id) {
          setSelectedPaymentMethod(newMethod.id);
        }
        setNewCardNumber('');
        setNewCardExpMonth('');
        setNewCardExpYear('');
        setNewCardCVV('');
        setNewCardName('');
        setShowAddCardModal(false);
      }
    } catch (error: any) {
      const msg = error.response?.data?.detail || t('appointments.cardSaveError', 'No se pudo guardar la tarjeta. Intenta de nuevo.');
      Alert.alert('Error', msg);
    } finally {
      setSavingCard(false);
    }
  };

  const loadTimeSlots = async (date: Date) => {
    try {
      setLoadingSlots(true);
      const dateStr = format(date, 'yyyy-MM-dd');
      const res = await api.get(`/public/available-slots?date=${dateStr}`);
      setTimeSlots((res.data || []).map((s: any) => ({
        time: s.time,
        datetime: s.datetime || `${dateStr}T${s.time}:00-06:00`,
        available: s.available,
      })));
    } catch (e) {
      setTimeSlots([]);
    } finally {
      setLoadingSlots(false);
    }
  };

  const onRefresh = useCallback(() => { setRefreshing(true); loadAppointments(); }, []);

  // Calendar days - force Sunday as first day (US standard)
  const calendarDays = useMemo(() => {
    const s = startOfWeek(startOfMonth(currentMonth), { weekStartsOn: 0 });
    const e = endOfWeek(endOfMonth(currentMonth), { weekStartsOn: 0 });
    return eachDayOfInterval({ start: s, end: e });
  }, [currentMonth]);

  const handleDateSelect = (date: Date) => {
    setSelectedDate(date);
    setSelectedTime(null);
    loadTimeSlots(date);
  };

  // Filter appointments
  const now = new Date();
  const upcomingAppointments = appointments.filter(
    a => new Date(a.scheduled_at) > now && a.status !== 'cancelled' && a.status !== 'completed'
  ).sort((a, b) => new Date(a.scheduled_at).getTime() - new Date(b.scheduled_at).getTime());

  const pastAppointments = appointments.filter(
    a => new Date(a.scheduled_at) <= now || a.status === 'cancelled' || a.status === 'completed'
  );

  const nextAppointment = upcomingAppointments[0];

  // Book appointment
  const handleBookAppointment = async () => {
    if (!selectedDate || !selectedTime) {
      Alert.alert(t('common.error'), t('appointments.selectDateAndTime'));
      return;
    }
    // Validate attendees if multi-person
    if (quantity > 1) {
      const incomplete = attendees.find(a => !a.name.trim());
      if (incomplete || attendees.length < quantity - 1) {
        Alert.alert('Datos Incompletos', 'Por favor completa el nombre de cada persona adicional.');
        return;
      }
    }
    try {
      setBooking(true);
      const slot = timeSlots.find(s => s.time === selectedTime);
      
      // Build attendees list
      const allAttendees = [
        { name: user?.name || user?.full_name || '', phone: user?.phone || '', email: user?.email || '', relationship: 'self' },
        ...attendees.map(a => ({ name: a.name, phone: a.phone || '', email: '', relationship: a.relationship || 'other' })),
      ];
      
      const titleParts = [selectedService?.name || 'Consulta'];
      if (quantity > 1) titleParts.push(`(${quantity} personas)`);

      const res = await api.post('/appointments', {
        title: `Cita: ${titleParts.join(' ')}`,
        description: `${appointmentType === 'video_call' ? t('appointments.videoCall', 'Videollamada') : t('appointments.inPerson', 'Presencial')} - ${titleParts.join(' ')}`,
        appointment_type: appointmentType,
        scheduled_at: slot?.datetime || `${format(selectedDate, 'yyyy-MM-dd')}T${selectedTime}:00`,
        duration_minutes: (selectedService?.duration_minutes || 30) * quantity,
        service_id: selectedService?.id,
        quantity: quantity,
        attendees: allAttendees,
        payment_method_id: selectedPaymentMethod || undefined,
      });
      
      const formattedDate = format(selectedDate, t('appointments.dateFormatDayMonth'), { locale: dateLocale });
      const personasText = quantity > 1 ? ` para ${quantity} personas` : '';
      Alert.alert(
        `✅ ${t('appointments.appointmentBooked')}`,
        `Cita agendada${personasText}\n${formattedDate} a las ${selectedTime}`
      );
      setSelectedDate(null);
      setSelectedTime(null);
      setQuantity(1);
      setAttendees([]);
      setShowAttendeeForm(false);
      loadAppointments();
    } catch (error: any) {
      const msg = error?.response?.data?.detail || t('appointments.couldNotSchedule');
      Alert.alert(t('common.error'), msg);
    } finally {
      setBooking(false);
    }
  };

  // Appointment actions
  const joinVideoCall = async (apt: Appointment) => {
    if (!apt.meeting_link) { Alert.alert(t('common.error'), t('appointments.noLinkAvailable')); return; }
    await Linking.openURL(apt.meeting_link);
  };

  const addToCalendar = async (apt: Appointment) => {
    // expo-calendar disabled due to TurboModule crash on iOS
    // Show manual instructions instead
    Alert.alert(
      t('appointments.addToCalendarTitle', 'Agregar al Calendario'),
      t('appointments.addToCalendarManual', `Para agregar esta cita a tu calendario:\n\n📅 ${apt.title}\n🕐 ${format(new Date(apt.scheduled_at), 'PPP p', { locale: dateLocale })}\n📍 ${apt.appointment_type === 'video_call' ? 'Video llamada' : '305 Bruce Ave, Dumas, TX 79029'}`),
      [{ text: 'OK' }]
    );
  };

  const cancelAppointment = (id: string) => {
    Alert.alert(t('appointments.cancelAppointmentTitle'), t('appointments.cancelAppointmentDesc'), [
      { text: t('appointments.no'), style: 'cancel' },
      { text: t('appointments.yesCancel'), style: 'destructive', onPress: async () => {
        try { await api.delete(`/appointments/${id}`); loadAppointments(); Alert.alert('✅', t('appointments.cancelSuccess')); }
        catch { Alert.alert(t('common.error'), t('appointments.couldNotCancel')); }
      }},
    ]);
  };

  const openMaps = () => {
    const addr = '305 Bruce Ave, Dumas, TX 79029';
    const url = Platform.select({ ios: `maps://app?daddr=${encodeURIComponent(addr)}`, android: `google.navigation:q=${encodeURIComponent(addr)}` });
    if (url) Linking.openURL(url);
  };

  const getCountdown = (d: string) => {
    const dt = new Date(d);
    if (isPast(dt)) return null;
    const days = differenceInDays(dt, now);
    const hrs = differenceInHours(dt, now) % 24;
    const mins = differenceInMinutes(dt, now) % 60;
    if (isToday(dt)) return hrs === 0 ? t('appointments.inMinutes', { mins }) : t('appointments.todayIn', { hrs, mins });
    if (isTomorrow(dt)) return t('appointments.tomorrow');
    if (days <= 7) return t('appointments.inDays', { days });
    return null;
  };

  const canJoinNow = (d: string) => {
    const diff = (new Date(d).getTime() - now.getTime()) / 60000;
    return diff <= 15 && diff >= -60;
  };

  if (loading) {
    return (
      <View style={s.container}>
        <LinearGradient colors={[C.primary, C.primaryLight]} style={[s.header, { paddingTop: insets.top + 12 }]}>
          <Text style={s.headerTitle}>{t('appointments.title')}</Text>
          <Text style={s.headerSub}>{t('appointments.subtitle')}</Text>
        </LinearGradient>
        <View style={s.loadingBox}>
          <ActivityIndicator size="large" color={C.primary} />
          <Text style={s.loadingText}>{t('common.loading')}</Text>
        </View>
      </View>
    );
  }

  return (
    <View style={s.container}>
      {/* Header */}
      <LinearGradient colors={[C.primary, C.primaryLight]} style={[s.header, { paddingTop: insets.top + 12 }]}>
        <Text style={s.headerTitle}>{t('appointments.myAppointments')}</Text>
        <Text style={s.headerSub}>{t('appointments.subtitle')}</Text>
      </LinearGradient>

      <ScrollView
        style={s.scroll}
        contentContainerStyle={s.scrollContent}
        showsVerticalScrollIndicator={false}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor={C.primary} />}
      >
        {/* Next Appointment Hero */}
        {nextAppointment && (
          <View style={s.nextAptCard}>
            <LinearGradient colors={['#1e293b', '#334155']} style={s.nextAptGradient}>
              <View style={s.nextAptTop}>
                <View style={s.nextAptCountdown}>
                  <Text style={s.nextAptCountdownText}>
                    {getCountdown(nextAppointment.scheduled_at) || t('appointments.nextAppointment')}
                  </Text>
                </View>
                <View style={s.nextAptType}>
                  <Ionicons name={nextAppointment.appointment_type === 'video_call' ? 'videocam' : 'business'} size={14} color="#fff" />
                  <Text style={s.nextAptTypeText}>
                    {nextAppointment.appointment_type === 'video_call' ? t('appointments.videoCall', 'Virtual') : t('appointments.inPerson', 'Presencial')}
                  </Text>
                </View>
              </View>
              <Text style={s.nextAptTitle} numberOfLines={1}>
                {nextAppointment.title.replace('Appointment: ', '').replace('Cita: ', '')}
              </Text>
              <View style={s.nextAptDetails}>
                <View style={s.nextAptDetail}>
                  <Ionicons name="calendar" size={14} color="rgba(255,255,255,0.8)" />
                  <Text style={s.nextAptDetailText}>
                    {format(new Date(nextAppointment.scheduled_at), t('appointments.dateFormatDayMonthShort'), { locale: dateLocale })}
                  </Text>
                </View>
                <View style={s.nextAptDetail}>
                  <Ionicons name="time" size={14} color="rgba(255,255,255,0.8)" />
                  <Text style={s.nextAptDetailText}>
                    {format(new Date(nextAppointment.scheduled_at), 'h:mm a')}
                  </Text>
                </View>
                <View style={s.nextAptDetail}>
                  <Ionicons name="hourglass" size={14} color="rgba(255,255,255,0.8)" />
                  <Text style={s.nextAptDetailText}>{nextAppointment.duration_minutes} min</Text>
                </View>
              </View>
              <View style={s.nextAptActions}>
                {nextAppointment.appointment_type === 'video_call' && canJoinNow(nextAppointment.scheduled_at) ? (
                  <TouchableOpacity style={s.nextAptBtn} onPress={() => joinVideoCall(nextAppointment)}>
                    <Ionicons name="videocam" size={16} color={C.primary} />
                    <Text style={s.nextAptBtnText}>{t('appointments.join')}</Text>
                  </TouchableOpacity>
                ) : (
                  <TouchableOpacity style={s.nextAptBtn} onPress={() => addToCalendar(nextAppointment)}>
                    <Ionicons name="calendar-outline" size={16} color={C.primary} />
                    <Text style={s.nextAptBtnText}>{t('appointments.addToCalendar')}</Text>
                  </TouchableOpacity>
                )}
                <TouchableOpacity style={s.nextAptBtnSec} onPress={() => cancelAppointment(nextAppointment.id)}>
                  <Ionicons name="close-circle-outline" size={16} color="#ff6b6b" />
                </TouchableOpacity>
              </View>
            </LinearGradient>
          </View>
        )}

        {/* More upcoming */}
        {upcomingAppointments.length > 1 && (
          <View style={s.moreUpcoming}>
            <Text style={s.sectionLabel}>{t('appointments.otherUpcoming')}</Text>
            {upcomingAppointments.slice(1).map(apt => (
              <View key={apt.id} style={s.miniAptCard}>
                <View style={[s.miniAptDot, { backgroundColor: C.success }]} />
                <View style={{ flex: 1 }}>
                  <Text style={s.miniAptTitle} numberOfLines={1}>
                    {apt.title.replace('Appointment: ', '').replace('Cita: ', '')}
                  </Text>
                  <Text style={s.miniAptDate}>
                    {format(new Date(apt.scheduled_at), t('appointments.dateFormatFull'), { locale: dateLocale })}
                  </Text>
                </View>
                <Text style={s.miniAptBadge}>
                  {apt.appointment_type === 'video_call' ? '📹' : '🏢'}
                </Text>
              </View>
            ))}
          </View>
        )}

        {/* Office Status */}
        {officeStatus && (
          <View style={[s.officeBar, { backgroundColor: officeStatus.is_open ? '#ECFDF5' : '#FEF2F2' }]}>
            <View style={[s.officeBarDot, { backgroundColor: officeStatus.is_open ? C.success : C.danger }]} />
            <Text style={[s.officeBarText, { color: officeStatus.is_open ? '#065F46' : '#991B1B' }]}>
              {officeStatus.is_open ? t('appointments.officeOpen') : t('appointments.officeClosed')} 
              {officeStatus.hours ? ` • ${t('appointments.hours')}: ${officeStatus.hours.open} - ${officeStatus.hours.close}` : ''}
            </Text>
          </View>
        )}

        {/* Section: Agendar nueva cita */}
        <Text style={s.sectionTitle}>{t('appointments.scheduleNew')}</Text>

        {/* Appointment Type Toggle */}
        <View style={s.typeToggle}>
          <TouchableOpacity
            style={[s.typeBtn, appointmentType === 'in_person' && s.typeBtnActive]}
            onPress={() => setAppointmentType('in_person')}
          >
            <Ionicons name="business" size={20} color={appointmentType === 'in_person' ? C.primary : C.textMut} />
            <Text style={[s.typeBtnText, appointmentType === 'in_person' && s.typeBtnTextActive]}>{t('appointments.inPerson')}</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[s.typeBtn, appointmentType === 'video_call' && s.typeBtnActive]}
            onPress={() => setAppointmentType('video_call')}
          >
            <Ionicons name="videocam" size={20} color={appointmentType === 'video_call' ? C.primary : C.textMut} />
            <Text style={[s.typeBtnText, appointmentType === 'video_call' && s.typeBtnTextActive]}>{t('appointments.videoCall')}</Text>
          </TouchableOpacity>
        </View>

        {/* Service Selector */}
        {services.length > 1 && (
          <ScrollView horizontal showsHorizontalScrollIndicator={false} style={s.servicesScroll}>
            {services.map(svc => (
              <TouchableOpacity
                key={svc.id}
                style={[s.serviceChip, selectedService?.id === svc.id && s.serviceChipActive]}
                onPress={() => setSelectedService(svc)}
              >
                <Text style={[s.serviceChipText, selectedService?.id === svc.id && s.serviceChipTextActive]}>
                  {svc.name} ({svc.duration_minutes} min)
                </Text>
              </TouchableOpacity>
            ))}
          </ScrollView>
        )}

        {/* Multi-Person Selector */}
        <View style={s.personSection}>
          <Text style={s.personLabel}>{t('appointments.howManyPeople', '¿Para cuántas personas?')}</Text>
          <View style={s.personCounter}>
            <TouchableOpacity
              style={[s.personBtn, quantity <= 1 && s.personBtnDisabled]}
              onPress={() => {
                if (quantity > 1) {
                  setQuantity(quantity - 1);
                  setAttendees(prev => prev.slice(0, quantity - 2));
                }
              }}
              disabled={quantity <= 1}
            >
              <Ionicons name="remove" size={20} color={quantity <= 1 ? C.textMut : C.primary} />
            </TouchableOpacity>
            <View style={s.personCountBox}>
              <Ionicons name="people" size={18} color={C.primary} />
              <Text style={s.personCountText}>{quantity}</Text>
            </View>
            <TouchableOpacity
              style={[s.personBtn, quantity >= 6 && s.personBtnDisabled]}
              onPress={() => {
                if (quantity < 6) {
                  setQuantity(quantity + 1);
                  if (attendees.length < quantity) {
                    setAttendees(prev => [...prev, { name: '', phone: '', relationship: 'other' }]);
                  }
                }
              }}
              disabled={quantity >= 6}
            >
              <Ionicons name="add" size={20} color={quantity >= 6 ? C.textMut : C.primary} />
            </TouchableOpacity>
          </View>
          {quantity > 1 && (
            <Text style={s.personHint}>
              Duración: ~{(selectedService?.duration_minutes || 30) * quantity} min
            </Text>
          )}
        </View>

        {/* Attendee Forms (when multiple people) */}
        {quantity > 1 && (
          <View style={s.attendeesCard}>
            <View style={s.attendeesHeader}>
              <Ionicons name="people" size={18} color={C.primary} />
              <Text style={s.attendeesTitle}>Personas adicionales ({attendees.length}/{quantity - 1})</Text>
            </View>
            {/* First person is always the logged-in user */}
            <View style={s.attendeeRow}>
              <View style={s.attendeeBadge}>
                <Text style={s.attendeeBadgeText}>1</Text>
              </View>
              <View style={s.attendeeInfo}>
                <Text style={s.attendeeName}>{user?.name || user?.full_name || 'Tú'}</Text>
                <Text style={s.attendeeDetail}>{user?.phone || user?.email || 'Titular'}</Text>
              </View>
              <View style={s.attendeeSelfBadge}>
                <Text style={s.attendeeSelfText}>Tú</Text>
              </View>
            </View>

            {/* Additional attendees forms */}
            {attendees.map((att, idx) => (
              <View key={idx} style={s.attendeeFormRow}>
                <View style={s.attendeeBadge}>
                  <Text style={s.attendeeBadgeText}>{idx + 2}</Text>
                </View>
                <View style={s.attendeeInputs}>
                  <View style={s.attendeeInputRow}>
                    <TextInput
                      style={s.attendeeTextInput}
                      value={att.name}
                      onChangeText={(v) => {
                        const updated = [...attendees];
                        updated[idx] = { ...updated[idx], name: v };
                        setAttendees(updated);
                      }}
                      placeholder="Nombre completo *"
                      placeholderTextColor={C.textMut}
                      autoCapitalize="words"
                    />
                    <TextInput
                      style={s.attendeeTextInput}
                      value={att.phone}
                      onChangeText={(v) => {
                        const updated = [...attendees];
                        updated[idx] = { ...updated[idx], phone: v };
                        setAttendees(updated);
                      }}
                      placeholder={t('appointments.phonePlaceholder', 'Teléfono *')}
                      placeholderTextColor={C.textMut}
                      keyboardType="phone-pad"
                    />
                  </View>
                </View>
                <TouchableOpacity
                  style={s.removeAttendeeBtn}
                  onPress={() => {
                    setAttendees(prev => prev.filter((_, i) => i !== idx));
                    setQuantity(prev => Math.max(1, prev - 1));
                  }}
                >
                  <Ionicons name="close-circle" size={22} color={C.danger} />
                </TouchableOpacity>
              </View>
            ))}
          </View>
        )}

        {/* Calendar */}
        <View style={s.calendarCard}>
          {/* Month Navigation */}
          <View style={s.calMonthRow}>
            <TouchableOpacity onPress={() => { setCurrentMonth(subMonths(currentMonth, 1)); setSelectedDate(null); setSelectedTime(null); }}>
              <Ionicons name="chevron-back" size={22} color={C.text} />
            </TouchableOpacity>
            <Text style={s.calMonthText}>{format(currentMonth, 'MMMM yyyy', { locale: dateLocale })}</Text>
            <TouchableOpacity onPress={() => { setCurrentMonth(addMonths(currentMonth, 1)); setSelectedDate(null); setSelectedTime(null); }}>
              <Ionicons name="chevron-forward" size={22} color={C.text} />
            </TouchableOpacity>
          </View>

          {/* Day Names */}
          <View style={s.calDayNames}>
            {DAY_NAMES.map(d => (
              <Text key={d} style={s.calDayName}>{d}</Text>
            ))}
          </View>

          {/* Calendar Grid */}
          <View style={s.calGrid}>
            {calendarDays.map((day, idx) => {
              const isCurMonth = isSameMonth(day, currentMonth);
              const isSel = selectedDate ? isSameDay(day, selectedDate) : false;
              const isPastDay = day < new Date(new Date().setHours(0, 0, 0, 0));
              const isTod = isToday(day);

              return (
                <TouchableOpacity
                  key={idx}
                  style={[
                    s.calDay,
                    !isCurMonth && s.calDayOther,
                    isSel && s.calDaySel,
                    isTod && !isSel && s.calDayToday,
                  ]}
                  onPress={() => !isPastDay && isCurMonth && handleDateSelect(day)}
                  disabled={isPastDay || !isCurMonth}
                  activeOpacity={0.7}
                >
                  <Text style={[
                    s.calDayText,
                    !isCurMonth && s.calDayTextOther,
                    isPastDay && s.calDayTextPast,
                    isSel && s.calDayTextSel,
                    isTod && !isSel && s.calDayTextToday,
                  ]}>
                    {format(day, 'd')}
                  </Text>
                </TouchableOpacity>
              );
            })}
          </View>
        </View>

        {/* Time Slots */}
        {selectedDate && (
          <View style={s.slotsSection}>
            <Text style={s.slotsTitle}>
              {t('appointments.availableTimes')} — {format(selectedDate, t('appointments.dateFormatDayMonth'), { locale: dateLocale })}
            </Text>
            {loadingSlots ? (
              <ActivityIndicator size="small" color={C.primary} style={{ marginVertical: 20 }} />
            ) : timeSlots.filter(sl => sl.available).length === 0 ? (
              <View style={s.noSlotsBox}>
                <Ionicons name="time-outline" size={24} color={C.textMut} />
                <Text style={s.noSlotsText}>{t('appointments.noSlotsAvailable')}</Text>
              </View>
            ) : (
              <View style={s.slotsGrid}>
                {timeSlots.filter(sl => sl.available).map((slot, idx) => (
                  <TouchableOpacity
                    key={idx}
                    style={[s.slotChip, selectedTime === slot.time && s.slotChipActive]}
                    onPress={() => setSelectedTime(slot.time)}
                  >
                    <Text style={[s.slotChipText, selectedTime === slot.time && s.slotChipTextActive]}>
                      {slot.time}
                    </Text>
                  </TouchableOpacity>
                ))}
              </View>
            )}

            {/* Book Button */}
            {selectedTime && (
              <>
                {/* Payment Method Section (Optional) */}
                <View style={s.paymentSection}>
                  <TouchableOpacity 
                    style={s.paymentSectionHeader}
                    onPress={() => setShowPaymentSection(!showPaymentSection)}
                    activeOpacity={0.7}
                  >
                    <View style={s.paymentSectionLeft}>
                      <Ionicons name="card-outline" size={20} color={C.primary} />
                      <View>
                        <Text style={s.paymentSectionTitle}>
                          {t('appointments.paymentMethod', 'Método de Pago')}
                        </Text>
                        <Text style={s.paymentSectionSubtitle}>
                          {selectedPaymentMethod 
                            ? (() => {
                                const pm = paymentMethods.find(m => m.id === selectedPaymentMethod);
                                return pm ? `${pm.card_brand || 'Tarjeta'} ****${pm.last_4}` : t('appointments.cardSelected', 'Tarjeta seleccionada');
                              })()
                            : t('appointments.optionalFasterCheckout', 'Opcional · Agiliza tu visita')}
                        </Text>
                      </View>
                    </View>
                    <View style={s.paymentSectionRight}>
                      {selectedPaymentMethod && (
                        <View style={s.paymentCheckBadge}>
                          <Ionicons name="checkmark" size={12} color="#fff" />
                        </View>
                      )}
                      <Ionicons 
                        name={showPaymentSection ? 'chevron-up' : 'chevron-down'} 
                        size={18} 
                        color={C.textMut} 
                      />
                    </View>
                  </TouchableOpacity>

                  {showPaymentSection && (
                    <View style={s.paymentSectionContent}>
                      {loadingPayments ? (
                        <ActivityIndicator size="small" color={C.primary} style={{ paddingVertical: 16 }} />
                      ) : paymentMethods.length > 0 ? (
                        <>
                          <Text style={s.paymentHint}>
                            {t('appointments.selectCardHint', 'Selecciona una tarjeta para pagar más rápido el día de tu cita ⚡')}
                          </Text>
                          {/* No payment option */}
                          <TouchableOpacity
                            style={[s.paymentMethodCard, !selectedPaymentMethod && s.paymentMethodCardActive]}
                            onPress={() => setSelectedPaymentMethod(null)}
                          >
                            <View style={s.paymentMethodRadio}>
                              {!selectedPaymentMethod && <View style={s.paymentMethodRadioDot} />}
                            </View>
                            <Ionicons name="cash-outline" size={20} color={!selectedPaymentMethod ? C.primary : C.textMut} />
                            <Text style={[s.paymentMethodText, !selectedPaymentMethod && s.paymentMethodTextActive]}>
                              {t('appointments.payLater', 'Pagar el día de la cita')}
                            </Text>
                          </TouchableOpacity>
                          {/* Saved cards */}
                          {paymentMethods.map(pm => (
                            <TouchableOpacity
                              key={pm.id}
                              style={[s.paymentMethodCard, selectedPaymentMethod === pm.id && s.paymentMethodCardActive]}
                              onPress={() => setSelectedPaymentMethod(pm.id)}
                            >
                              <View style={s.paymentMethodRadio}>
                                {selectedPaymentMethod === pm.id && <View style={s.paymentMethodRadioDot} />}
                              </View>
                              <Ionicons name="card" size={20} color={selectedPaymentMethod === pm.id ? C.primary : C.textMut} />
                              <View style={{ flex: 1 }}>
                                <Text style={[s.paymentMethodText, selectedPaymentMethod === pm.id && s.paymentMethodTextActive]}>
                                  {pm.card_brand || 'Tarjeta'} ****{pm.last_4}
                                </Text>
                                {pm.cardholder_name && (
                                  <Text style={s.paymentMethodSubtext}>{pm.cardholder_name}</Text>
                                )}
                              </View>
                              {pm.is_default && (
                                <View style={s.defaultBadge}>
                                  <Text style={s.defaultBadgeText}>
                                    {t('appointments.defaultCard', 'Principal')}
                                  </Text>
                                </View>
                              )}
                            </TouchableOpacity>
                          ))}
                          {/* Add new card button */}
                          <TouchableOpacity
                            style={s.addCardInlineBtn}
                            onPress={() => setShowAddCardModal(true)}
                          >
                            <Ionicons name="add-circle-outline" size={18} color={C.primary} />
                            <Text style={s.addCardInlineBtnText}>
                              {t('appointments.addNewCard', 'Agregar nueva tarjeta')}
                            </Text>
                          </TouchableOpacity>
                        </>
                      ) : (
                        <View style={s.noPaymentBox}>
                          <Ionicons name="card-outline" size={28} color={C.textMut} />
                          <Text style={s.noPaymentText}>
                            {t('appointments.noPaymentMethods', 'No tienes métodos de pago guardados')}
                          </Text>
                          <TouchableOpacity 
                            style={s.addPaymentBtn}
                            onPress={() => setShowAddCardModal(true)}
                          >
                            <Ionicons name="add-circle-outline" size={18} color={C.primary} />
                            <Text style={s.addPaymentBtnText}>
                              {t('appointments.addPaymentMethod', 'Agregar tarjeta')}
                            </Text>
                          </TouchableOpacity>
                        </View>
                      )}
                    </View>
                  )}
                </View>

              <TouchableOpacity
                style={s.bookBtn}
                onPress={handleBookAppointment}
                disabled={booking}
                activeOpacity={0.85}
              >
                <LinearGradient colors={[C.primary, C.primaryLight]} style={s.bookBtnGradient}>
                  {booking ? (
                    <ActivityIndicator color="#fff" />
                  ) : (
                    <>
                      <Ionicons name="checkmark-circle" size={20} color="#fff" />
                      <Text style={s.bookBtnText}>
                        {t('appointments.confirmBookingBtn', { date: format(selectedDate, t('appointments.dateFormatDayMonthShort'), { locale: dateLocale }), time: selectedTime })}
                      </Text>
                    </>
                  )}
                </LinearGradient>
              </TouchableOpacity>
              </>
            )}
          </View>
        )}

        {/* History Toggle */}
        {pastAppointments.length > 0 && (
          <TouchableOpacity style={s.historyToggle} onPress={() => setShowHistory(!showHistory)}>
            <Ionicons name="time-outline" size={18} color={C.textSec} />
            <Text style={s.historyToggleText}>{t('appointments.history')} ({pastAppointments.length})</Text>
            <Ionicons name={showHistory ? 'chevron-up' : 'chevron-down'} size={18} color={C.textMut} />
          </TouchableOpacity>
        )}

        {/* History List */}
        {showHistory && pastAppointments.map(apt => {
          const isPastApt = new Date(apt.scheduled_at) < now;
          return (
            <View key={apt.id} style={s.historyCard}>
              <View style={s.historyCardLeft}>
                <Ionicons
                  name={apt.status === 'cancelled' ? 'close-circle' : 'checkmark-circle'}
                  size={20}
                  color={apt.status === 'cancelled' ? C.danger : C.info}
                />
              </View>
              <View style={{ flex: 1 }}>
                <Text style={s.historyTitle} numberOfLines={1}>
                  {apt.title.replace('Appointment: ', '').replace('Cita: ', '')}
                </Text>
                <Text style={s.historyDate}>
                  {format(new Date(apt.scheduled_at), t('appointments.dateFormatHistory'), { locale: dateLocale })}
                </Text>
              </View>
              <Text style={[s.historyStatus, { color: apt.status === 'cancelled' ? C.danger : C.info }]}>
                {apt.status === 'cancelled' ? t('appointments.cancelled', 'Cancelada') : t('appointments.completed', 'Completada')}
              </Text>
            </View>
          );
        })}

        <View style={{ height: 120 }} />
      </ScrollView>

      {/* ============ ADD CARD MODAL ============ */}
      <Modal
        visible={showAddCardModal}
        animationType="slide"
        transparent={true}
        onRequestClose={() => setShowAddCardModal(false)}
      >
        <View style={s.modalOverlay}>
          <KeyboardAvoidingView
            behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
            style={{ width: '100%', justifyContent: 'flex-end' }}
          >
            <View style={s.modalContent}>
              <View style={s.modalHeader}>
                <Text style={s.modalTitle}>
                  {t('appointments.addCard', '💳 Agregar Tarjeta')}
                </Text>
                <TouchableOpacity onPress={() => setShowAddCardModal(false)} style={s.modalCloseBtn}>
                  <Ionicons name="close" size={24} color={C.text} />
                </TouchableOpacity>
              </View>

              <Text style={s.modalSubtitle}>
                {t('appointments.addCardSubtitle', 'Tu tarjeta se guardará de forma segura para el día de tu cita')}
              </Text>

              <ScrollView style={s.modalForm} showsVerticalScrollIndicator={false}>
                {/* Card Number */}
                <Text style={s.formLabel}>{t('appointments.cardNumber', 'Número de Tarjeta')}</Text>
                <TextInput
                  style={s.formInput}
                  value={newCardNumber}
                  onChangeText={(text) => setNewCardNumber(formatCardNumber(text))}
                  placeholder="1234 5678 9012 3456"
                  placeholderTextColor={C.textMut}
                  keyboardType="number-pad"
                  maxLength={19}
                />

                {/* Exp + CVV Row */}
                <View style={s.formRow}>
                  <View style={s.formCol}>
                    <Text style={s.formLabel}>{t('appointments.expMonth', 'Mes')}</Text>
                    <TextInput
                      style={s.formInput}
                      value={newCardExpMonth}
                      onChangeText={setNewCardExpMonth}
                      placeholder="MM"
                      placeholderTextColor={C.textMut}
                      keyboardType="number-pad"
                      maxLength={2}
                    />
                  </View>
                  <View style={s.formCol}>
                    <Text style={s.formLabel}>{t('appointments.expYear', 'Año')}</Text>
                    <TextInput
                      style={s.formInput}
                      value={newCardExpYear}
                      onChangeText={setNewCardExpYear}
                      placeholder="YY"
                      placeholderTextColor={C.textMut}
                      keyboardType="number-pad"
                      maxLength={2}
                    />
                  </View>
                  <View style={s.formCol}>
                    <Text style={s.formLabel}>CVV</Text>
                    <TextInput
                      style={s.formInput}
                      value={newCardCVV}
                      onChangeText={setNewCardCVV}
                      placeholder="123"
                      placeholderTextColor={C.textMut}
                      keyboardType="number-pad"
                      maxLength={4}
                      secureTextEntry
                    />
                  </View>
                </View>

                {/* Cardholder Name */}
                <Text style={s.formLabel}>{t('appointments.cardholderName', 'Nombre del Titular')}</Text>
                <TextInput
                  style={s.formInput}
                  value={newCardName}
                  onChangeText={setNewCardName}
                  placeholder={t('appointments.cardholderPlaceholder', 'Como aparece en la tarjeta')}
                  placeholderTextColor={C.textMut}
                  autoCapitalize="words"
                />

                {/* Security note */}
                <View style={s.securityNote}>
                  <Ionicons name="lock-closed" size={14} color={C.primary} />
                  <Text style={s.securityNoteText}>
                    {t('appointments.secureEncryption', 'Tus datos se encriptan con AES-256 y se guardan en el vault seguro de NMI')}
                  </Text>
                </View>

                {/* Save Button */}
                <TouchableOpacity
                  style={[s.saveCardBtn, savingCard && { opacity: 0.6 }]}
                  onPress={handleSaveCardInline}
                  disabled={savingCard}
                  activeOpacity={0.85}
                >
                  <LinearGradient colors={[C.primary, C.primaryLight]} style={s.saveCardBtnGradient}>
                    {savingCard ? (
                      <ActivityIndicator color="#fff" />
                    ) : (
                      <>
                        <Ionicons name="shield-checkmark" size={18} color="#fff" />
                        <Text style={s.saveCardBtnText}>
                          {t('appointments.saveCard', 'Guardar Tarjeta')}
                        </Text>
                      </>
                    )}
                  </LinearGradient>
                </TouchableOpacity>

                <View style={{ height: 30 }} />
              </ScrollView>
            </View>
          </KeyboardAvoidingView>
        </View>
      </Modal>

    </View>
  );
}

const createStyles = (colors: any) => StyleSheet.create({
  container: { flex: 1, backgroundColor: colors.background },
  loadingBox: { flex: 1, justifyContent: 'center', alignItems: 'center', gap: 12 },
  loadingText: { fontSize: 15, color: colors.textSecondary, fontWeight: '500' },

  // Header - Premium Design
  header: { 
    paddingHorizontal: 20, 
    paddingBottom: 24, 
    borderBottomLeftRadius: 28, 
    borderBottomRightRadius: 28,
    // Decorative shadow
    shadowColor: colors.primary,
    shadowOffset: { width: 0, height: 8 },
    shadowOpacity: 0.15,
    shadowRadius: 16,
    elevation: 10,
  },
  headerTitle: { fontSize: 26, fontWeight: '800', color: '#fff', letterSpacing: -0.5 },
  headerSub: { fontSize: 14, color: 'rgba(255,255,255,0.85)', marginTop: 4, fontWeight: '500' },

  // Scroll
  scroll: { flex: 1 },
  scrollContent: { padding: 16, paddingTop: 20 },

  // Next appointment - Premium Card
  nextAptCard: { 
    borderRadius: 24, 
    overflow: 'hidden', 
    marginBottom: 20, 
    shadowColor: colors.primary, 
    shadowOffset: { width: 0, height: 8 }, 
    shadowOpacity: 0.25, 
    shadowRadius: 16, 
    elevation: 10,
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.1)',
  },
  nextAptGradient: { padding: 20 },
  nextAptTop: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 },
  nextAptCountdown: { backgroundColor: 'rgba(255,255,255,0.25)', paddingHorizontal: 14, paddingVertical: 6, borderRadius: 20 },
  nextAptCountdownText: { color: '#fff', fontSize: 13, fontWeight: '700' },
  nextAptType: { flexDirection: 'row', alignItems: 'center', gap: 4, backgroundColor: 'rgba(255,255,255,0.15)', paddingHorizontal: 10, paddingVertical: 4, borderRadius: 10 },
  nextAptTypeText: { color: '#fff', fontSize: 11, fontWeight: '600' },
  nextAptTitle: { fontSize: 18, fontWeight: '700', color: '#fff', marginBottom: 12 },
  nextAptDetails: { flexDirection: 'row', gap: 14, marginBottom: 16 },
  nextAptDetail: { flexDirection: 'row', alignItems: 'center', gap: 5 },
  nextAptDetailText: { color: 'rgba(255,255,255,0.85)', fontSize: 13, fontWeight: '500' },
  nextAptActions: { flexDirection: 'row', gap: 10 },
  nextAptBtn: { flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 6, backgroundColor: '#fff', paddingVertical: 11, borderRadius: 12 },
  nextAptBtnText: { color: colors.primary, fontSize: 13, fontWeight: '700' },
  nextAptBtnSec: { width: 44, height: 44, borderRadius: 12, backgroundColor: 'rgba(255,255,255,0.15)', justifyContent: 'center', alignItems: 'center' },

  // More upcoming
  moreUpcoming: { marginBottom: 16 },
  sectionLabel: { fontSize: 13, fontWeight: '700', color: colors.textSecondary, marginBottom: 8, textTransform: 'uppercase', letterSpacing: 0.5 },
  miniAptCard: { flexDirection: 'row', alignItems: 'center', backgroundColor: colors.cardBackground, borderRadius: 14, padding: 14, marginBottom: 8, shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.04, shadowRadius: 4, elevation: 2, borderWidth: 1, borderColor: colors.border },
  miniAptDot: { width: 8, height: 8, borderRadius: 4, marginRight: 12 },
  miniAptTitle: { fontSize: 14, fontWeight: '600', color: colors.text, marginBottom: 2 },
  miniAptDate: { fontSize: 12, color: colors.textMuted },
  miniAptBadge: { fontSize: 16 },

  // Office bar
  officeBar: { flexDirection: 'row', alignItems: 'center', borderRadius: 12, padding: 12, gap: 8, marginBottom: 16 },
  officeBarDot: { width: 8, height: 8, borderRadius: 4 },
  officeBarText: { fontSize: 13, fontWeight: '600' },

  // Section
  sectionTitle: { fontSize: 18, fontWeight: '700', color: colors.text, marginBottom: 12, letterSpacing: -0.3 },

  // Type toggle
  typeToggle: { flexDirection: 'row', gap: 10, marginBottom: 14 },
  typeBtn: { flex: 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8, backgroundColor: colors.cardBackground, paddingVertical: 14, borderRadius: 14, borderWidth: 1.5, borderColor: colors.border },
  typeBtnActive: { borderColor: colors.primary, backgroundColor: colors.primary + '08' },
  typeBtnText: { fontSize: 14, fontWeight: '600', color: colors.textMuted },
  typeBtnTextActive: { color: colors.primary },

  // Services
  servicesScroll: { marginBottom: 14 },
  serviceChip: { paddingHorizontal: 16, paddingVertical: 10, borderRadius: 20, backgroundColor: colors.cardBackground, marginRight: 8, borderWidth: 1, borderColor: colors.border },
  serviceChipActive: { backgroundColor: colors.primary, borderColor: colors.primary },
  serviceChipText: { fontSize: 13, fontWeight: '600', color: colors.textSecondary },
  serviceChipTextActive: { color: '#fff' },

  // Calendar - Premium Apple-style
  calendarCard: { 
    backgroundColor: colors.cardBackground, 
    borderRadius: 24, 
    padding: 20, 
    marginBottom: 20, 
    shadowColor: '#000', 
    shadowOffset: { width: 0, height: 6 }, 
    shadowOpacity: 0.08, 
    shadowRadius: 16, 
    elevation: 6, 
    borderWidth: 1, 
    borderColor: colors.border,
  },
  calMonthRow: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20, paddingHorizontal: 4 },
  calMonthText: { fontSize: 20, fontWeight: '800', color: colors.text, textTransform: 'capitalize', letterSpacing: -0.5 },
  calDayNames: { flexDirection: 'row', marginBottom: 12, paddingBottom: 12, borderBottomWidth: 1, borderBottomColor: colors.border },
  calDayName: { flex: 1, textAlign: 'center', fontSize: 13, fontWeight: '700', color: colors.textMuted, textTransform: 'uppercase', letterSpacing: 0.5 },
  calGrid: { flexDirection: 'row', flexWrap: 'wrap' },
  calDay: { width: '14.28%', aspectRatio: 1, justifyContent: 'center', alignItems: 'center', borderRadius: 14 },
  calDayOther: { opacity: 0.3 },
  calDaySel: { backgroundColor: colors.primary, borderRadius: 14, shadowColor: colors.primary, shadowOffset: { width: 0, height: 4 }, shadowOpacity: 0.3, shadowRadius: 8, elevation: 4 },
  calDayToday: { backgroundColor: colors.primary + '18', borderRadius: 14, borderWidth: 2, borderColor: colors.primary + '30' },
  calDayText: { fontSize: 15, fontWeight: '600', color: colors.text },
  calDayTextOther: { color: colors.textMuted },
  calDayTextPast: { color: colors.textMuted, opacity: 0.4 },
  calDayTextSel: { color: '#fff', fontWeight: '800' },
  calDayTextToday: { color: colors.primary, fontWeight: '800' },

  // Slots - Premium Time Selection
  slotsSection: { marginBottom: 20 },
  slotsTitle: { fontSize: 16, fontWeight: '700', color: colors.text, marginBottom: 14, letterSpacing: -0.3 },
  noSlotsBox: { flexDirection: 'row', alignItems: 'center', gap: 12, backgroundColor: colors.warningLight, borderRadius: 16, padding: 18, borderWidth: 1, borderColor: colors.warning + '40' },
  noSlotsText: { flex: 1, fontSize: 14, color: '#92400E', fontWeight: '500', lineHeight: 20 },
  slotsGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: 10 },
  slotChip: { 
    paddingHorizontal: 20, 
    paddingVertical: 14, 
    borderRadius: 14, 
    backgroundColor: colors.cardBackground, 
    borderWidth: 2, 
    borderColor: colors.border,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.04,
    shadowRadius: 4,
    elevation: 2,
  },
  slotChipActive: { 
    backgroundColor: colors.primary, 
    borderColor: colors.primary,
    shadowColor: colors.primary,
    shadowOpacity: 0.3,
    shadowRadius: 8,
    elevation: 4,
  },
  slotChipText: { fontSize: 15, fontWeight: '700', color: colors.text },
  slotChipTextActive: { color: '#fff' },

  // Book button - Premium Gradient
  bookBtn: { marginTop: 20, borderRadius: 18, overflow: 'hidden' },
