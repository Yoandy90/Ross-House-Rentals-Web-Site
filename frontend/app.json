{
  "expo": {
    "name": "Ross House",
    "slug": "ross-house-rentals",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rossrentals",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-dark.png",
      "resizeMode": "cover",
      "backgroundColor": "#0C0C0E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rosshouse.rentals",
      "buildNumber": "127",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for inspections and maintenance requests",
        "NSPhotoLibraryUsageDescription": "Attach photos to inspections and chat messages",
        "NSPhotoLibraryAddUsageDescription": "Save signed contracts and receipts to your device",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "photos.listhub.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "listhub.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0C0E"
      },
      "package": "com.rosshouse.rentals",
      "versionCode": 127,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload photos for maintenance requests"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ED1B33"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91de519a-68be-41a3-9d4f-2cb96d451a71"
      }
    },
    "owner": "yoandy90"
  }
}