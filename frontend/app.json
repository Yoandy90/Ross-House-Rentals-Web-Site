{
  "expo": {
    "name": "Ross Tax",
    "slug": "ross-tax",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rosstax",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "description": "Gestiona tus impuestos de manera fácil y segura. Agenda citas, sube documentos, y accede a tu asistente AI personal para preparación de taxes.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rosstax.wallet",
      "buildNumber": "1116",
      "icon": "./assets/images/icon.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para escanear y subir documentos fiscales",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para que puedas subir documentos desde tu galería",
        "NSLocationWhenInUseUsageDescription": "Rastrea tu ruta GPS y detecta estados para IFTA",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rastrea tu ruta GPS en segundo plano para registro de millas",
        "NSCalendarsUsageDescription": "Agrega tus citas de Ross Tax directamente a tu calendario",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rosstax.wallet",
      "versionCode": 369,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true,
            "deploymentTarget": "15.1"
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.rosstax.wallet",
          "enableGooglePay": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-iap",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona fotos de documentos para tus trámites fiscales",
          "cameraPermission": "Escanea documentos fiscales con la cámara"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C1110",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backendUrl": "https://app-nueva-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "deba5612-9639-451d-9c1c-272d68cc992c"
      }
    },
    "owner": "yoandy90",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}